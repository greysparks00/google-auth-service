{
    "name": "google-auth-service",
    "runtime": {
        "port": 8082,
        "install": ["uv", "sync"],
        "command": [
            "uv", "run", "uvicorn", "main:app",
            "--host", "127.0.0.1",
            "--port", "8082"
        ]
    },
    "routing": {
        "prefix": "/googleauth"
    },
    "health": {
        "path": "/health"
    }
}